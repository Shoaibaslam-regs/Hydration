# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/aqua

# Secret for signing session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional: map search (geocoding). Defaults to OpenStreetMap's public Nominatim,
# which allows light use only and asks for a contact email.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_CONTACT_EMAIL=you@example.com
